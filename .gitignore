# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# secrets — Google Earth Engine service-account keys, etc. (never commit)
# Track the folder's README so the path is documented, ignore everything else.
/secrets/*
!/secrets/README.md
*ee-key*.json
*service-account*.json
*.iam.gserviceaccount.com.json

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# ONNX model weights — download via public/models/README.md instructions
public/models/*.onnx
public/models/*.pt

# debug
ccdoc
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# env files (can opt-in for committing if needed)
.env*
# ...but not the template.
!.env.example
geoagent.rar
# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
# Root-level local overrides only (anchored, so source files named local-* are kept).
/local-*
*.log
dev.log
dev.out.log
/test
/prompt

server.log
# Autonomous QA sweep output (screenshots + raw JSONL) — regenerate with scripts/agent-qa/
qa-out/

# stray database files (the database is PostgreSQL; nothing should create these)
*.db
*.db-journal

# playwright
/test-results/
/playwright-report/

# local PostgreSQL cluster (scripts/dev-db.sh)
/.pgdata

# internal working notes and design studies (not part of the product repo)
/docs/
/.design/

# competition materials kept locally
/.pitch/
