# GeoAgent — environment variables
# Copy to .env and fill in values

# Database — PostgreSQL 16 everywhere (Q-21). Local cluster: scripts/dev-db.sh (port 5433), which
# prints these two URLs. DATABASE_URL_TEST is used by the database tests and the e2e server (they
# skip / refuse to run without it); it can point at the same server.
DATABASE_URL=postgresql://geoagent@127.0.0.1:5433/geoagent
DATABASE_URL_TEST=postgresql://geoagent@127.0.0.1:5433/geoagent_test
# docker-compose only: password of the bundled postgres service.
# POSTGRES_PASSWORD=

# TLS — remove if using http:// or a valid cert
# Never in production. Only for a local TLS-intercepting proxy you trust; prefer NODE_EXTRA_CA_CERTS.
# NODE_TLS_REJECT_UNAUTHORIZED=0

# ─── Authentication (C1 — next-auth, OPT-IN; anonymous use needs none of this) ──
# Auth is additive: with NO provider configured, sign-in is unavailable and the app
# stays fully anonymous (projects scoped by a per-browser x-owner-token). Configure a
# provider to make signed-in users' projects private to their account (owner key
# `account:<id>`). Uses JWT sessions (no DB adapter / no schema migration).
# NEXTAUTH_SECRET=                 # required for signed JWT sessions in production (openssl rand -base64 32)
# NEXTAUTH_URL=http://localhost:3000
# GITHUB_ID=                       # GitHub OAuth app client id  → enables "Sign in with GitHub"
# GITHUB_SECRET=                   # GitHub OAuth app client secret
# Email magic-link needs a database adapter (verification tokens) — documented follow-up.

# ─── AI provider ──────────────────────────────────────────────────────────────
# GeoAgent supports multiple LLM providers. Configure one of the options below.
# The provider is selected in-app via Settings → AI Model (stored in localStorage),
# but you can also set a default base URL here for Ollama.
#
# Recommended no-key default: Ollama (runs locally, no account required)
#   1. Install from https://ollama.com  →  ollama pull qwen2.5:7b
#   2. Set the base URL below (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434   # only needed to override the default.
#   When set, GET /api/health also probes this endpoint and reports the installed
#   model list, loaded-model VRAM, and round-trip latency (informational only).
#
# OpenAI:
# OPENAI_API_KEY=sk-...
#
# Anthropic (Claude):
# ANTHROPIC_API_KEY=sk-ant-...
#
# Google Gemini:
# GEMINI_API_KEY=AI...
# ──────────────────────────────────────────────────────────────────────────────

# External data API endpoints (all free, no auth required)
STAC_ENDPOINT=https://earth-search.aws.element84.com/v1
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
# DEM point-stats source (mapzen ~30m global by default; srtm90m/srtm30m/aster30m also valid)
OPEN_ELEVATION_ENDPOINT=https://api.opentopodata.org/v1/mapzen

# ─── Data tiers (C2 — honest free / commercial / user-upload) ─────────────────
# Tier 0 (free, default): Sentinel-2 10 m, Landsat, WorldCover, OSM, etc. — no keys.
# Tier 1 (commercial sub-meter, OPT-IN, labeled "commercial"): set ONE provider key.
# MAPBOX_TOKEN=
# MAXAR_API_KEY=
# PLANET_API_KEY=
# Tier 2 (user GeoTIFF/COG upload → self-hosted TiTiler → analyzable). OFF by default
# (writes to disk + needs a TiTiler that can read the public URL). To enable:
# ENABLE_UPLOADS=1
# UPLOAD_DIR=./public/uploads                 # where uploaded COGs are stored (served at /uploads)
# PUBLIC_BASE_URL=http://app:3000             # base URL the TiTiler uses to fetch stored COGs

# ─── Routing (Valhalla — isochrones + A→B routes) ─────────────────────────────
# fetch_isochrone / query_route use Valhalla. Unset (default) = the shared public
# https://valhalla.openstreetmap.de instance: fine for dev, but no SLA (SUSP-014).
# For production, self-host Valhalla (see the commented `valhalla` service in
# docker-compose.yml — needs a one-time regional OSM graph build) and point this at it:
# VALHALLA_ENDPOINT=http://localhost:8002
# Likewise OVERPASS_ENDPOINT (above) can point at a self-hosted Overpass for the whole
# free OSM path to run on owned infra (see the commented `overpass` service).

# ─── Raster tiles (TiTiler) ───────────────────────────────────────────────────
# NDVI / spectral / DEM / thermal / surface-water / population rasters are tiled by
# TiTiler. Unset (default) = the shared public https://titiler.xyz instance: fine for
# dev, but rate-limited with no SLA — the main cause of tiles intermittently rendering
# as a flat colour. For production, self-host TiTiler (see the `titiler` service in
# docker-compose.yml) and point this at it for reliable, fast tiles:
# TITILER_ENDPOINT=http://localhost:8000

# ─── Google Earth Engine (optional, OPT-IN raster accelerator) ────────────────
# By default the app renders rasters from TiTiler (TITILER_ENDPOINT above) — fast and
# reliable. GEE compute is high-quality but slow, so it is NOT used unless you BOTH
# configure a key AND set GEE_PREFERRED=1 (otherwise a slow/failing GEE config would tax
# every query). When preferred, NDVI / spectral / DEM / LST render from GEE (cloud-masked
# median composites, multi-scene mosaics, polygon means, server-side clip).
# GEE_PREFERRED=1                             # opt in to the GEE raster backend (default: off)
# GEE_KEY_FILE=./secrets/ee-key.json          # path to the service-account JSON key
# GEE_SERVICE_ACCOUNT_KEY=                     # OR the JSON key inline (one line)

# ─── Fetch cache (P5.1) ─────────────────────────────────────────────────────
# In-process TTL + LRU cache for read-only external fetches (STAC, Overpass, DEM,
# Open-Meteo, SoilGrids, …). No config needed for the default in-memory L1 cache.
# AGENT_CACHE_DIR=        # optional L2: directory for a file-backed disk cache that
#                         # survives restarts (deterministic results only: SoilGrids,
#                         # DEM, signed asset URLs). Leave unset to use memory only.
# AGENT_CACHE_MAX_ENTRIES=200   # optional: L1 LRU capacity (default 200)

# ─── Perception / CV models (Phase 1) ────────────────────────────────────────
#
# Models are PLUGGABLE. Register them in the UI (Settings → Perception Models) or
# here in GEOAGENT_MODELS — either way, no redeploy and no code change. Each entry:
#
#   { "id":         unique key you call it by,
#     "provider":   local-onnx | roboflow | custom-http     (see note on hf below)
#     "ref":        local-onnx  → https URL to a .onnx file, or an absolute local path
#                   roboflow    → "project/version"
#                   custom-http → absolute http(s) endpoint
#     "task":       detect | segment | classify | embed,
#     "classes":    ["car", ...]        optional, ordered as the model exports them
#     "input_size": 640,                optional (default 640)
#     "profile":    tiny | base | large  see MODEL_PROFILE below (default base)
#     "license":    "AGPL-3.0",         optional, carried into provenance
#     "resolution_m": 0.3 }             optional, used for the honesty check
#
# GEOAGENT_MODELS=[{"id":"my_cars","provider":"local-onnx","ref":"https://host/best.onnx","task":"detect","classes":["car"],"profile":"tiny"}]
#
# MODEL_PROFILE — which weights are allowed to load on this machine. Auto-detected
# from total VRAM (nvidia-smi, summed across GPUs) when unset:
#     >= 24 GB → large      >= 8 GB → base      otherwise → tiny
# `tiny` must run on 4 GB and on CPU. Set explicitly to override; anything a model
# declares above this tier is skipped AND reported, never silently dropped.
# MODEL_PROFILE=            # tiny | base | large
#
# The three bundled ONNX detectors (solar_panel / informal_struct / road_damage)
# are CURRENTLY UNAVAILABLE: the keremberke repos were deleted upstream (verified
# 404 at the HF repo API, 2026-08-10), so there is nothing to download. Register a
# replacement above, or drop an .onnx into public/models/ and point a local-onnx
# ref at it.
#
# ROBOFLOW_API_KEY=          # free at roboflow.com — enables the roboflow provider
#
# HF_API_TOKEN is a WEIGHT-DOWNLOAD token only. HuggingFace serverless inference
# serves none of the vision models this app needs — grounding-dino-tiny/base,
# sam2-hiera-large, owlv2 and clip-vit-base-patch32 all report ZERO inference
# providers (verified 2026-08-09, re-verified 2026-08-10). Setting it does NOT
# enable detection; it only raises download rate limits and reaches gated repos.
# HF_API_TOKEN=
#
# Hosted inference gateway (optional, used by detect_objects / segment_feature).
# `huggingface` is NOT a valid value — see the note above.
# INFERENCE_PROVIDER=        # replicate | selfhosted   (default: none)
# REPLICATE_API_TOKEN=       # for INFERENCE_PROVIDER=replicate
# INFERENCE_ENDPOINT=        # for INFERENCE_PROVIDER=selfhosted — your own model server

# Vision-language inspection (optional, used by inspect_imagery — Phase 2.5).
# Lets the agent LOOK at the rendered AOI and cross-check a statistic against the
# picture (cloud, snow, sensor artefact, scene context). Resolution order:
#   1. VLM_ENDPOINT + VLM_MODEL below — a local sidecar (Ollama / vLLM / llama.cpp);
#   2. the provider set in Settings → AI Model, when it is vision-capable
#      (OpenAI / Claude / Gemini) — no extra configuration needed;
#   3. OLLAMA_BASE_URL, but ONLY if that server reports a model with the `vision`
#      capability. A text-only model handed an image does not fail — it describes
#      what it imagines, so it is never used.
# With none of these set, inspect_imagery says so and describes nothing.
# VLM_ENDPOINT=              # e.g. http://localhost:11434  or  http://box:8000/v1
# VLM_MODEL=                 # e.g. qwen2.5vl:7b — required whenever VLM_ENDPOINT is set
# VLM_WIRE=                  # ollama | openai | claude  (inferred from the URL if omitted)
# VLM_API_KEY=               # only if the endpoint requires one

# Active fire detection (optional)
# FIRMS_MAP_KEY=             # free at firms.modaps.eosdis.nasa.gov/api/area/

# Air quality (optional — enables OpenAQ v3 station fallback alongside Open-Meteo CAMS primary)
# OPENAQ_API_KEY=            # free at openaq.org

# Auth (optional — next-auth is installed but not yet wired; see roadmap P6.3)
# GITHUB_ID=
# GITHUB_SECRET=
# NEXTAUTH_SECRET=           # openssl rand -base64 32
# NEXTAUTH_URL=http://localhost:3000

# ─── Test / CI only ─────────────────────────────────────────────────────────
# AGENT_ALLOW_STUB=1   # enables the deterministic offline "stub" AI provider used
#                      # by the SSE-contract smoke test (scripts/sse-smoke-test.mjs).
#                      # NEVER set this in a real deployment.

# ─── Server-side default AI provider (optional) ───────────────────────────────
# Without these, the app requires the user to pick a model in Settings → AI Model
# and /api/agent refuses with that instruction. Setting them lets a deployment
# answer out of the box, and lets an automated client (E2E) drive a real agent
# run without touching the Settings panel. A request that names its own provider
# always wins; these only fill in for 'default'.
# AGENT_DEFAULT_PROVIDER=ollama        # ollama | openai | claude | gemini | custom
# AGENT_DEFAULT_BASE_URL=http://localhost:11434
# AGENT_DEFAULT_MODEL=gemma4:26b-a4b-it-qat
# AGENT_DEFAULT_API_KEY=               # only for keyed providers

# ─── Server-held AI keys (hosted deployments) ─────────────────────────────────
# With these set the browser never needs a key: Settings shows "Server key configured" and the
# key field becomes optional. A key typed in Settings (bring your own) still wins unless
# GEOAGENT_DISABLE_CLIENT_KEYS=1. GET /api/providers reports which are configured (never the keys).
# A server-held key is only ever sent to the provider's own endpoint, never to a client-chosen URL.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GEOAGENT_DEFAULT_PROVIDER=claude     # used when a request says "default" (AGENT_DEFAULT_PROVIDER still works)
# GEOAGENT_DISABLE_CLIENT_KEYS=1       # ignore keys sent by browsers
# GEOAGENT_MODEL_CLAUDE=               # per-provider default model overrides (see lib/models.ts)
# Gemini (native @google/genai adapter). With GEMINI_API_KEY set and no GEOAGENT_DEFAULT_PROVIDER,
# Gemini is the default provider. Gemma 4 ids (gemma-4-31b-it) work under the same provider.
# GEOAGENT_MODEL_GEMINI=gemini-3.8-flash                       # pinned default; never a -latest alias
# GEOAGENT_MODEL_GEMINI_FALLBACKS=gemini-3.5-flash,gemini-2.5-flash   # tried in order after 429/5xx retries; empty = none
# GEOAGENT_GEMINI_THINKING_PLAN=low        # minimal | low | medium | high (Gemini 3 models only); the model turn that writes the plan
# GEOAGENT_GEMINI_THINKING_SYNTHESIS=low   # the turn that writes the analysis. GEOAGENT_GEMINI_THINKING sets both. See eval/RESULTS.md
# GEOAGENT_LLM_TIMEOUT_MS=110000           # per model call. A local model on CPU (Ollama without a GPU) can need minutes for one turn: raise it (e.g. 600000)
# GEOAGENT_MAX_OUTPUT_PLAN=6144            # output-token cap (thinking included) for the plan turn; GEOAGENT_MAX_OUTPUT_SYNTHESIS=8192 for the analysis turn
# AGENT_CACHE_MAX_MB=64                    # byte budget of the in-process cache of pixel grids and API answers (LRU)
# AGENT_TIME_BUDGET_MS=240000          # wall-clock for one agent run (min 5000); the last 40 s are held for the analysis. Proxies in front need a read timeout above it
# Browser-supplied base URLs and model endpoints are refused when private, link-local, metadata or
# (in production) loopback; they are ignored entirely when a server key exists or client keys are disabled.

# ─── Rate limits (in-memory token buckets, per account or per client IP) ─────
# Requests per window; defaults: agent 20 / 600 s, quick-layer 60, upload 10, jobs 30. 429 + Retry-After.
# RATE_LIMIT_AGENT_MAX=20  RATE_LIMIT_AGENT_WINDOW_S=600   (same for QUICK_LAYER, UPLOAD, JOBS)
# RATE_LIMIT_DISABLED=1
# GEOAGENT_TRUST_PROXY=1   # take the client IP from X-Real-IP / X-Forwarded-For (set only behind our nginx, which
#                          # overwrites them); `cloudrun` for Cloud Run (below). Without it all anonymous
#                          # callers share one bucket

# ─── Cloud Run (see deploy/cloudrun/README.md; the scripts set these) ────────
# GEOAGENT_TRUST_PROXY=cloudrun        # client IP = right-most X-Forwarded-For entry (appended by Google's front end)
# GEOAGENT_TRUSTED_PROXY_HOPS=1        # only if a load balancer sits in front of Cloud Run
# GEO_SERVICE_AUDIENCE=                # the geo service's Cloud Run URL: calls carry a Google ID token from the
#                                      # metadata server. Unset (local, compose) = no auth header.
# METRICS_TOKEN=                       # /api/metrics requires "Authorization: Bearer <token>"; unset = open
# RUN_MIGRATIONS=1                     # image entrypoint runs `prisma migrate deploy` first (compose); Cloud Run uses a Job
# JOB_WORKER=0                         # the job worker runs inside the web process; needs --no-cpu-throttling on Cloud Run
# GEO_CACHE_DIR=/data/composites       # geo service: composite COG cache. One instance only (tile URLs embed the id);
#                                      # a gcsfuse-mounted bucket path works to survive restarts
# Leave ENABLE_UPLOADS unset on Cloud Run: uploads write to the local disk. AGENT_ALLOW_STUB=1 stops the
# server from starting in production. Without EVIDENCE_SIGNING_KEY, /api/health reports "degraded" in production.
# Build args (Dockerfile): TITILER_ENDPOINT, CSP_CONNECT_EXTRA, GIT_SHA.

# ─── Content-Security-Policy (read at BUILD time by next.config.ts) ──────────
# TITILER_ENDPOINT's origin is added to img-src/connect-src. Extra tile/data origins the browser
# must reach, space-separated:
# CSP_CONNECT_EXTRA=https://tiles.example.org

# ─── Dataset registry readers (use_dataset) ─────────────────────────────────
# Datasets that need a credential are still listed and searched; without it
# use_dataset returns the dataset's facts and says exactly what is missing.
# EARTHDATA_TOKEN=       # NASA Earthdata (CMR-STAC) — urs.earthdata.nasa.gov/profile → Generate Token
# CDSE_TOKEN=            # Copernicus Data Space (CDSE) token
# OPENTOPO_API_KEY=      # OpenTopography (catalog lookups need no key; downloads do)
# GFW_API_KEY=           # Global Forest Watch data API
# Earth Engine datasets use GEE_KEY_FILE / GEE_SERVICE_ACCOUNT_KEY (see above).

# Evidence bundle signing (Q-29): Ed25519 PKCS8 PEM, plain or base64. Unset = ephemeral key per process (bundles say so).
# EVIDENCE_SIGNING_KEY=
# GIT_SHA=   # recorded in bundles; defaults to the commit at build time, else "unknown"
