    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.2",
    "hyparquet": "^1.31.3",
    "hyparquet-compressors": "^1.1.2",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.525.0",
    "maplibre-gl": "^6.14.0",
    "next": "^16.4.0",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.11.1",
    "proj4": "^2.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.3",
    "react-syntax-highlighter": "^15.6.1",
