# Copy to deploy/cloudrun/.env.deploy (git-ignored) and fill in. Nothing here is a secret.
PROJECT_ID=
PROFILE=free                    # free (default, stays in the always-free tier) | paid

# Database (PROFILE=free). vm (default): PostgreSQL 16 on an always-free e2-micro VM, created by setup.sh.
# cloudsql-trial: a Cloud SQL free-trial instance you create by hand in the console (30 days).
# DB_MODE=vm
# CLOUDSQL_INSTANCE=project:us-central1:name   # only for DB_MODE=cloudsql-trial
# DB_NAME=geoagent
# DB_USER=geoagent
# Optional (letters, digits, _ . ~ -); otherwise a random password is generated. Prefer exporting it.
# DB_PASSWORD=

# REGION=us-central1            # the free VM and Cloud Run free tier assume us-central1 (zone us-central1-a)
# GEOAGENT_MODEL_GEMINI=gemma-4-31b-it   # open Gemma model through the Gemini API instead of the default Gemini
# PROFILE=paid only:
# SQL_TIER=db-f1-micro          # smallest Cloud SQL tier
# TITILER_VERSION=2.4.0         # exact developmentseed/titiler release
# GEO_INGRESS=all               # all (IAM-protected) | internal (needs VPC egress on the web service, see README)
# GEO_CACHE_BUCKET=             # optional GCS bucket mounted as the geo cache (gcsfuse)

# Only read by setup.sh, only the first time the secret is created (FORCE_GEMINI_KEY=1 replaces it).
# Prefer exporting it in the shell instead of writing it in this file.
# GEMINI_API_KEY=
